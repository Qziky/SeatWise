{
  "name": "seatwise",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "description": "SeatWise - 面向中国中小学班主任的智能排座位助手 MVP",
  "license": "MIT",
  "keywords": [
    "seating-chart",
    "education",
    "teacher-tools",
    "nextjs",
    "privacy"
  ],
  "engines": {
    "node": "^22.9.0 || ^24.0.0",
    "npm": ">=11.16.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "audit:prod": "npm audit --omit=dev",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "check": "npm run check:toolchain && npm run lint && npm run typecheck && npm run test:coverage",
    "ci": "npm run check && npm run build && npm run audit:prod",
    "cleanup:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cleanup-local.ps1 -RemoveArtifacts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.561.0",
    "next": "15.5.20",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.2",
    "eslint-config-next": "15.5.20",
    "jsdom": "^27.3.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.16"
    }
  },
  "allowScripts": {
    "fsevents@2.3.2": false,
    "fsevents@2.3.3": false,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
